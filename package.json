{
  "name": "open-email",
  "private": true,
  "type": "module",
  "scripts": {
    "build:registry": "cd registry && forge build --skip test --skip script",
    "test": "npm run build:registry && vitest run && npm run test:forge",
    "test:forge": "cd registry && forge test --match-path 'test/*'",
    "test:client": "vitest run client",
    "test:relayer": "vitest run relayer",
    "test:l2": "RUN_L2_TESTS=1 vitest run relayer/src/l2.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "esbuild": "^0.28.2",
    "multiformats": "^14.0.5",
    "smtp-server": "^3.19.4",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/smtp-server": "^3.5.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
