{
  "name": "open-email",
  "private": true,
  "type": "module",
  "scripts": {
    "build:registry": "cd registry && forge build --skip test --skip script",
    "test": "npm run build:registry && vitest run && npm run test:forge",
    "test:forge": "cd registry && forge test --match-path 'test/*'",
    "test:client": "vitest run client",
    "test:relayer": "vitest run relayer",
    "test:l2": "RUN_L2_TESTS=1 vitest run relayer/src/l2.test.ts",
    "typecheck": "tsc --noEmit",
    "build:ui": "cd node/web && npm install && npm run build",
    "dev:ui": "node node/dev-ui.mjs",
    "dev:ui:backend": "HTTP_PORT=8787 node --experimental-strip-types --no-warnings node/dev-server.ts",
    "prototype:node-ui": "node node/prototype-ui/serve.mjs",
    "package": "bash package.sh"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "esbuild": "^0.28.2",
    "multiformats": "^14.0.5",
    "smtp-server": "^3.19.4",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5.0.2",
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vibed-infra": "0.13.0",
    "vitest": "^4.1.11",
    "vite": "^7.1.3"
  }
}
